<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Battery/RAM stats are permission-free (sticky broadcast + /proc/meminfo). -->
    <!-- INTERNET is only for loading the official device render from the Nothing store CDN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: top-apps-by-foreground-time ranking on the PROC tab (Settings grant, graceful without). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Required for Glyph Matrix control via Nothing's GDK. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ntop">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ntop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shizuku binder delivery: without this provider pingBinder() is
             always false and no permission dialog can ever appear. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- ntop Glyph Toy (AOD): appears in Settings > Always-on Glyph. -->
        <service
            android:name=".stats.GlyphToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/img_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
            <!-- Long press on the Glyph Button sends EVENT_CHANGE; without
                 this the toy's onLongPress() branch is unreachable. -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
        </service>
    </application>
</manifest>
