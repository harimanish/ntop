<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Battery/RAM stats are permission-free (sticky broadcast + /proc/meminfo). -->
    <!-- INTERNET is only for loading the official device render from the Nothing store CDN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: top-apps-by-foreground-time ranking on the PROC tab (Settings grant, graceful without). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ntop">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ntop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shizuku binder delivery: without this provider pingBinder() is
             always false and no permission dialog can ever appear. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
