<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ntop" parent="android:Theme.Material.NoActionBar.TranslucentDecor">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The launch animation is drawn by the app itself; a transparent
             system splash icon removes the duplicate logo and leaves just the
             black window, so the dots are the first thing on screen. -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
